# Copy this file to agents/.env (testnet) or agents/.env.mainnet (mainnet).
# Never commit either file — they contain private keys.
#
# Run the worker:
#   npx tsx agents/worker.ts                              # uses agents/.env
#   ENV_FILE=agents/.env.mainnet npx tsx agents/worker.ts # uses mainnet env
#
# Register ERC-8004:
#   npx tsx agents/register8004.ts
#   ENV_FILE=agents/.env.mainnet npx tsx agents/register8004.ts

# ── Network ───────────────────────────────────────────────────────────
# testnet (default) or mainnet
NETWORK=testnet

# RPC endpoint(s) for the chosen network.
# May be a single URL or a comma-separated list; multiple URLs are tried
# in order using viem's fallback() transport so the worker survives a
# provider outage without restarting.
#
# Arc Testnet public endpoints:
#   https://rpc.testnet.arc.io
#   https://rpc.quicknode.testnet.arc.io
#   https://rpc.drpc.testnet.arc.io
#   https://rpc.blockdaemon.testnet.arc.io
#
# Arc Mainnet public endpoints:
#   https://rpc.mainnet.arc.io
#   https://rpc.quicknode.mainnet.arc.io
#   https://rpc.drpc.mainnet.arc.io
#   https://rpc.blockdaemon.mainnet.arc.io
#
# Recommended: list all four so rate limits on one don't stall the worker.
RPC_URL=https://rpc.testnet.arc.io,https://rpc.quicknode.testnet.arc.io,https://rpc.drpc.testnet.arc.io,https://rpc.blockdaemon.testnet.arc.io

# ── Contract ──────────────────────────────────────────────────────────
# AgenticCommerce v2 (testnet)
CONTRACT_ADDRESS=0x1f5b9aa13b91b59951dd7f4326b6706e5465f3c8

# Block at which the contract was deployed.
# Testnet v2: 69223525
# Set this to the actual mainnet deploy block when NETWORK=mainnet
DEPLOY_BLOCK=69223525

# ── Anthropic ─────────────────────────────────────────────────────────
# Scribe, Polyglot, Bard, and Sentinel all call the Anthropic API.
# Lazy does not.
ANTHROPIC_API_KEY=sk-ant-...

# ── Agent private keys ────────────────────────────────────────────────
# Each key controls one agent wallet; the address is derived automatically.
# Fund each wallet with a small amount of USDC for gas.
SCRIBE_KEY=0x...
POLYGLOT_KEY=0x...
BARD_KEY=0x...
LAZY_KEY=0x...
SENTINEL_KEY=0x...

# ── LLM models (optional) ─────────────────────────────────────────────
# Provider agents (Scribe, Polyglot, Bard) use PROVIDER_MODEL.
# Sentinel evaluator uses EVALUATOR_MODEL.
# Defaults shown below — override to pin a specific version.
# PROVIDER_MODEL=claude-haiku-5-5
# EVALUATOR_MODEL=claude-sonnet-5-5

# ── Seeder (optional) ─────────────────────────────────────────────────
# Used only when running --seed N.  Falls back to SCRIBE_KEY if unset.
# SEEDER_KEY=0x...
